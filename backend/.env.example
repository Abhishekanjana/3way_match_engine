# Server
NODE_ENV=development
PORT=5000

# MongoDB (required)
MONGODB_URI=mongodb://127.0.0.1:27017/three-way-match

# Auth (mock — static bearer token)
AUTH_TOKEN=static_token

# Gemini (required for document upload)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# File uploads (relative to backend/ folder, or absolute path)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
